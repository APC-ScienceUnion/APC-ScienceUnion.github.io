- const sidebarEnglish = page.lang === 'en'
- const sidebarCategoryCount = sidebarEnglish ? bilingual_categories().length : site.categories.length
#sidebar
  #menu-mask
  #sidebar-menus
    .avatar-img.is-center
      img(src=url_for(theme.avatar.img) onerror=`onerror=null;src='${theme.error_img.flink}'` alt="avatar")
    .site-data.is-center
      .data-item
        a(href=sidebarEnglish ? url_for('/en/' + config.archive_dir + '/') : url_for(config.archive_dir) + '/')
          .headline= _p('aside.articles') 
          .length-num= site.posts.length

      if !sidebarEnglish
        .data-item
          a(href=url_for(config.tag_dir) + '/' )
            .headline= _p('aside.tags')
            .length-num= site.tags.length

      .data-item
        a(href=sidebarEnglish ? url_for('/en/' + config.category_dir + '/') : url_for(config.category_dir) + '/')
          .headline= _p('aside.categories')
          .length-num= sidebarCategoryCount

    hr
    !=partial('includes/header/menu_item', {}, {cache: false})
