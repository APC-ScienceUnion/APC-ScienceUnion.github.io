if theme.aside.card_author.enable
  - const authorCardEnglish = page.lang === 'en'
  - const englishCategoryCount = authorCardEnglish ? bilingual_categories().length : site.categories.length
  .card-widget.card-info
    .is-center
      .avatar-img
        img(src=url_for(theme.avatar.img) onerror=`this.onerror=null;this.src='` + url_for(theme.error_img.flink) + `'` alt="avatar")
      .author-info__name= authorCardEnglish ? (theme.english_author_name || 'APC Science Union') : config.author
      .author-info__description!= authorCardEnglish ? (theme.english_site_description || config.description) : (theme.aside.card_author.description || config.description)

    .card-info-data.is-center
      .card-info-data-item
        a(href=authorCardEnglish ? url_for('/en/' + config.archive_dir + '/') : url_for(config.archive_dir) + '/')
          .headline= _p('aside.articles') 
          .length-num= site.posts.length

      if !authorCardEnglish
        .card-info-data-item
          a(href=url_for(config.tag_dir) + '/')
            .headline= _p('aside.tags')
            .length-num= site.tags.length

      .card-info-data-item
        a(href=authorCardEnglish ? url_for('/en/' + config.category_dir + '/') : url_for(config.category_dir) + '/')
          .headline= _p('aside.categories') 
          .length-num= englishCategoryCount

    if theme.aside.card_author.button.enable
      a#card-info-btn(href=theme.aside.card_author.button.link)
        i(class=theme.aside.card_author.button.icon)
        span=authorCardEnglish ? 'Follow Us' : theme.aside.card_author.button.text
  
    if(theme.social)
        .card-info-social-icons.is-center
          !=fragment_cache('social', function(){return partial('includes/header/social')}) 
