if theme.Open_Graph_meta
  - let contentType = is_post() ? 'article' : 'website'
  - let metaImage = (page.cover || theme.avatar.img) ? full_url_for(page.cover || theme.avatar.img) : ''
  - let fb_appId = theme.facebook_comments.app_id || ''
  - let fb_admins = theme.facebook_comments.user_id || ''

  - let localizedSiteName = page.lang === 'en' && theme.english_site_title ? theme.english_site_title : config.title
  - let localizedDescription = page.description || page.excerpt || page.content || (page.lang === 'en' && theme.english_site_description ? theme.english_site_description : config.description)
  != open_graph({type: contentType, image: metaImage, description: localizedDescription, site_name: localizedSiteName, fb_admins: fb_admins, fb_app_id: fb_appId})

else
  meta(name="description" content=page_description())

