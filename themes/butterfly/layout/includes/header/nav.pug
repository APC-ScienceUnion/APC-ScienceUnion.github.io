nav#nav
  - const bilingual = bilingual_info(page)
  - const englishPage = bilingual.language === 'en'
  - const localizedSiteName = englishPage && theme.english_site_title ? theme.english_site_title : config.title
  if is_home()
    //- 首頁頂欄左側僅站名；副標題在 layout 中大標題下方
    .nav-site-brand
      .nav-brand-title
        a#site-name(href=url_for(englishPage ? '/en/' : '/'))= localizedSiteName
  else
    span#blog_name
      a#site-name(href=url_for(englishPage ? '/en/' : '/')) #[=localizedSiteName]

  #menus
    if (theme.algolia_search.enable || theme.local_search.enable)
      #search-button
        a.site-page.social-icon.search
          i.fas.fa-search.fa-fw
          span=' '+_p('search.title')
    !=partial('includes/header/menu_item', {}, {cache: false})

    #toggle-menu
      a.site-page
        i.fas.fa-bars.fa-fw

    #language-switch
      - const languageLabel = englishPage ? '阅读中文版' : 'Read in English'
      a.site-page.social-icon.language-switch(
        href=url_for(bilingual.switchPath)
        title=languageLabel
        aria-label=languageLabel
        lang=bilingual.targetLanguage
        hreflang=bilingual.targetLanguage
      )
        i.fas.fa-language.fa-fw(aria-hidden='true')

