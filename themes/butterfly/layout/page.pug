extends includes/layout.pug

block content
  if page.type === 'community-account' && !(config.community && config.community.enable)
    #page
      h1.page-title= page.title
      p= page.lang === 'en' ? 'Accounts and comments are not available yet.' : '账号与评论功能暂未开放。'
  else if page.type === 'categories'
    include includes/page/categories.pug
  else if page.type === 'apc-news'
    include includes/page/apc-news.pug
  else
    #page
      if top_img === false
        h1.page-title= page.title

      case page.type
        when 'tags'
          include includes/page/tags.pug
        when 'link'
          include includes/page/flink.pug
        default
          include includes/page/default-page.pug

  if page.comments !== false && theme.comments && theme.comments.use
    - var commentsJsLoad = true
    !=partial('includes/third-party/comments/index', {}, {cache: true})
