extends includes/layout.pug

block page_head
  link(rel='stylesheet' href=url_for('/honor-hall/styles.css') + '?v=honor-hall-20260830-2')

block content
  #page
    if top_img === false
      h1.page-title= page.title

    #honor-hall(data-honor-hall-root data-asset-version='honor-hall-20260830-2')
    noscript
      p.honor-hall-noscript= page.lang === 'en' ? 'Certificate search and galleries require JavaScript.' : '荣誉证书查询与画廊需要启用 JavaScript。'

block page_scripts
  script(src=url_for(page.honor_hall_data || '/honor-hall/data.js') + '?v=honor-hall-20260830-2')
  script(src=url_for('/honor-hall/app.js') + '?v=honor-hall-20260830-2')
