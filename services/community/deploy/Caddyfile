api.apc-science.cn {
    log {
        output file /var/log/caddy/apc-api-access.json {
            mode 0600
            roll_size 10MiB
            roll_keep -1
            roll_keep_for 4800h
        }
        format filter {
            wrap json
            fields {
                request>headers delete
                request>uri delete
                resp_headers delete
            }
        }
    }
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
    request_body {
        max_size 16KB
    }
    handle /account/* {
        redir https://apc-science.cn/account/ 302
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:8787 {
            header_up X-Real-IP {remote_host}
            header_up X-Client-Port {remote_port}
            header_up X-Server-Address {http.request.local.host}
            header_up X-Server-Port {http.request.local.port}
        }
    }
    handle {
        respond "Not found" 404
    }
}

img.apc-science.cn {
    log {
        output file /var/log/caddy/apc-img-access.json {
            mode 0600
            roll_size 10MiB
            roll_keep -1
            roll_keep_for 4800h
        }
        format filter {
            wrap json
            fields {
                request>headers delete
                request>uri delete
                resp_headers delete
            }
        }
    }
    root * /srv/apc-media
    @images path_regexp images \.(?i:png|jpe?g|gif|webp|avif|svg|ico|bmp|tiff?)$
    handle @images {
        header {
            Cache-Control "public, max-age=86400"
            Access-Control-Allow-Origin "*"
            X-Content-Type-Options nosniff
            Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
        }
        file_server
    }
    handle {
        respond "Not found" 404
    }
}
