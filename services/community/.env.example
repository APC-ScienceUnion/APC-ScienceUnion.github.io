NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/community.sqlite
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
ALLOWED_ORIGINS=https://apc-science.cn,https://www.apc-science.cn
# Set the owner's real email before accepting registrations. This is never sent to the browser.
ADMIN_EMAIL=
ADMIN_NICKNAME=guinyの时光
TOPICS_FILE=./data/community-topics.json
# Enable only when the API listens behind the bundled loopback reverse proxy.
TRUST_PROXY=false
# Production refuses the test mail transport.
MAIL_TRANSPORT=resend
MAIL_FROM=
RESEND_API_KEY=
# Hard caps for free plans. Exhaustion returns an error; no paid fallback.
MAIL_DAILY_LIMIT=90
MAIL_MONTHLY_LIMIT=2900
